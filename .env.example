# ============================================================
# SentinelAI — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
DB_HOST=postgres            # Docker Compose service name; on Render use the internal hostname
DB_PORT=5432
DB_NAME=sentinel
DB_USER=sentinel_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# --- AI Service ---
# Internal URL (used by the backend to reach the AI service)
# Docker Compose: http://ai-service:8000
# Render:         use the private service URL from the Render dashboard
AI_SERVICE_URL=http://ai-service:8000

# --- JWT ---
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string
JWT_EXPIRATION_MS=86400000

# --- Spring Boot JPA DDL (use "validate" in production, "update" in dev)
JPA_DDL_AUTO=update
